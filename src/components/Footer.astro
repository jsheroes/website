---
import Bear from "./ui/Bear.astro";
import Button from "./ui/Button.astro";
import Frieze from "./ui/Frieze.astro";
import Motif from "./ui/Motif.astro";
import { event } from "../data/event";
import { cta, footerGroups, legalLinks } from "../data/navigation";
---

<footer
  data-tone="ink"
  class="relative overflow-hidden bg-black-pearl text-white"
>
  <div class="pointer-events-none absolute top-6 right-[-6rem] hidden opacity-100 lg:block xl:right-[max(2rem,calc(50%-36rem))]">
    <Motif name="m4_night" cell={18} />
  </div>

  <div class="relative mx-auto grid w-full max-w-[1160px] gap-12 px-5 pt-16 pb-24 md:px-8 xl:px-0">
    <div>
      <h2 class="h2-section max-w-[12ch] text-[clamp(2.75rem,2rem+3.5vw,4.75rem)] leading-none">
        See you in Transylvania.
      </h2>
      <p class="mt-6 text-lg font-semibold text-accent-orange">
        {event.dates} · {event.venue.city}
      </p>
      {cta && (
        <Button href={cta.href} variant="accent" class="mt-8">
          {cta.label}
        </Button>
      )}

      <div class="mt-14 grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-4 lg:max-w-[46rem]">
        {footerGroups.map((group) => (
          <nav aria-label={group.title}>
            <h2 class="eyebrow mb-4 text-accent-orange">{group.title}</h2>
            <ul class="m-0 flex list-none flex-col gap-2 p-0 text-[0.9375rem]">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="no-underline hover:underline hover:decoration-accent-orange hover:decoration-2 hover:underline-offset-4"
                    {...(link.external && {
                      target: "_blank",
                      rel: "noreferrer noopener",
                    })}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
      </div>
    </div>
  </div>

  <div class="relative mx-auto w-full max-w-[1160px] px-5 pb-8 md:px-8 xl:px-0">
    <div class="flex flex-col gap-3 lg:max-w-[46rem] border-t border-white/20 pt-6 text-sm text-white/80 sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0">© {new Date().getFullYear()} · JSHeroes</p>
      <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0">
        {legalLinks.map((link) => (
          <li>
            <a href={link.href} class="no-underline hover:underline">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="pointer-events-none absolute right-[max(1rem,calc(50%-36rem))] bottom-[calc(36px+1rem)] z-10 hidden items-end lg:flex">
    <Bear who="male" width={250} />
    <Bear who="female" width={214} class="-ml-8" />
  </div>

  <Frieze kind="diamond" tone="night" />
</footer>
