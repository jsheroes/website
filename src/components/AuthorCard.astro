---
import { Image } from "astro:assets";
import PersonDialog from "./ui/PersonDialog.astro";
import { personDialogId, type Person } from "../utils/people";

/** Author byline that opens the person's profile dialog. */
export interface Props {
  author: Person;
  publishDate?: string;
}

const { author, publishDate } = Astro.props;
---

<div style="--plate: var(--color-accent-pink); --tint: var(--color-tint-coral)">
  <button
    type="button"
    class="group flex cursor-pointer items-center gap-4 border-0 bg-transparent p-0 text-left text-inherit"
    aria-haspopup="dialog"
    data-person-dialog={personDialogId(author)}
  >
    <span class="block h-14 w-14 shrink-0 overflow-hidden bg-[var(--tint)]">
      <Image
        src={author.data.photo}
        alt=""
        width={56}
        height={56}
        densities={[1, 2]}
        class="h-full w-full object-cover object-top mix-blend-multiply grayscale"
      />
    </span>
    <span class="flex flex-col">
      <span class="text-lg leading-tight font-bold group-hover:underline group-hover:decoration-accent-pink group-hover:decoration-2 group-hover:underline-offset-4">
        {author.data.name}
      </span>
      <span class="text-sm text-soft">{publishDate ?? author.data.title}</span>
    </span>
  </button>

  <PersonDialog person={author} />
</div>
