---
import Button from "./ui/Button.astro";
import { editions } from "../data/editions";
import { cta, footerGroups, primaryNav } from "../data/navigation";

const pastEditions = editions.filter((e) => e.archiveUrl).reverse();
const menuGroups = footerGroups.filter((g) => g.title !== "Follow");
const path = Astro.url.pathname;
---

<header class="relative z-30 h-24">
  <div class="mx-auto flex h-full max-w-[1160px] items-center justify-between gap-6 px-5 md:px-8 xl:px-0">
    <a
      href="/"
      class="text-[1.875rem] leading-none font-extrabold tracking-tight no-underline"
      aria-label="JSHeroes, home"
      aria-current={path === "/" ? "page" : undefined}
    >
      <span class="text-blue-logo">JS</span>Heroes
    </a>

    <nav class="flex items-center gap-4 lg:gap-9" aria-label="Main">
      <ul class="m-0 hidden list-none items-center gap-9 p-0 lg:flex">
        {primaryNav.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-[0.9375rem] font-medium no-underline hover:underline hover:decoration-accent-pink hover:decoration-2 hover:underline-offset-8"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      {cta && (
        <Button href={cta.href} size="sm" class="hidden sm:inline-flex">
          {cta.label}
        </Button>
      )}
      <button
        type="button"
        popovertarget="site-menu"
        class="flex h-11 w-11 cursor-pointer items-center justify-center border-2 border-black-pearl bg-transparent p-0 text-black-pearl"
        aria-label="Menu"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          aria-hidden="true"
          fill="currentColor"
        >
          <path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z" />
        </svg>
      </button>
    </nav>
  </div>
</header>

<!-- Popover: Esc and outside clicks close it, focus returns to the button. -->
<nav
  id="site-menu"
  popover="auto"
  data-tone="ink"
  aria-label="Site"
  class="site-menu m-0 ml-auto h-dvh w-full max-w-[28rem] overflow-y-auto border-0 bg-black-pearl p-0 text-white"
>
  <div class="flex items-center justify-between px-6 py-5">
    <span class="eyebrow text-accent-orange">Menu</span>
    <button
      type="button"
      popovertarget="site-menu"
      popovertargetaction="hide"
      class="flex h-11 w-11 cursor-pointer items-center justify-center border-2 border-white bg-transparent p-0 text-white"
      aria-label="Close menu"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-6 w-6"
        aria-hidden="true"
        fill="currentColor"
      >
        <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
      </svg>
    </button>
  </div>

  <div class="flex flex-col gap-8 px-6 pt-2 pb-12">
    {cta && (
      <Button href={cta.href} variant="accent" class="self-start sm:hidden">
        {cta.label}
      </Button>
    )}

    {menuGroups.map((group) => (
      <section>
        <h2 class="eyebrow mb-3 text-accent-orange">{group.title}</h2>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
          {group.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="block py-1 no-underline hover:text-accent-orange"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section>
      <h2 class="eyebrow mb-3 text-accent-orange">Past editions</h2>
      <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0">
        {pastEditions.map((edition) => (
          <li>
            <a
              href={edition.archiveUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="block py-1 no-underline hover:text-accent-orange"
            >
              {edition.year}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</nav>

<style>
  .site-menu {
    inset: 0 0 0 auto;
  }
  .site-menu::backdrop {
    background: rgb(0 28 43 / 0.6);
  }
  .site-menu:popover-open {
    animation: slide-in 200ms ease-out;
  }
  @keyframes slide-in {
    from {
      transform: translateX(100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-menu:popover-open {
      animation: none;
    }
  }
</style>
