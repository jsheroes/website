---
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Motif from "../ui/Motif.astro";
import Scribble from "../ui/Scribble.astro";
import { hero } from "../../data/home";
import { art, mid } from "../../data/hero-art";
import { cta } from "../../data/navigation";
---

<section
  data-section="hero"
  class="relative -mt-24 flex flex-col overflow-hidden bg-paper"
>
  <!--
    From lg up, the text and facts bar fill at least one viewport
    (min-h-[100dvh], flex-1 on the text block absorbs the slack), so the
    facts bar sits flush against the fold on load. Below lg the hero keeps
    its natural height and the facts bar simply follows the text.
  -->
  <div class="flex flex-col lg:min-h-[100dvh]">
    <!-- Stair corners live in the page margin, so they only appear where the margin is wide enough to hold them. -->
    <Motif
      name="st_brand"
      cell={6}
      class="absolute top-0 left-0 hidden xl:block 3xl:hidden"
      loading="eager"
    />
    <Motif
      name="st_brand"
      cell={6}
      flip
      class="absolute top-0 right-0 hidden xl:block 3xl:hidden"
      loading="eager"
    />
    <Motif
      name="st_brand"
      cell={12}
      class="absolute top-0 left-0 hidden 3xl:block"
      loading="eager"
    />
    <Motif
      name="st_brand"
      cell={12}
      flip
      class="absolute top-0 right-0 hidden 3xl:block"
      loading="eager"
    />

    <!-- Full cluster from xl, positioned on the 1440 design grid. Scaled 20%
         smaller, anchored so the top barely moves (already cleared the nav)
         and nearly all the shrink comes out of the bottom, away from the
         facts bar: real browsers render the fluid heading a little
         differently than our own testing, so this keeps a wide margin
         rather than the thinnest one that measured clean. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 hidden 3xl:block"
    >
      <div class="absolute top-0 left-1/2 h-full w-[1440px] origin-[1082px_259px] -translate-x-1/2 scale-[0.8]">
        {art.map(({ name, cell, left, top, motion, dur, delay, rd }) => (
          <div class="absolute" style={`left:${left}px;top:${top}px`}>
            <Motif
              name={name}
              cell={cell}
              loading="eager"
              motion={motion}
              dur={dur}
              delay={delay}
              reveal="pixel"
              revealDelay={rd}
            />
          </div>
        ))}
      </div>
    </div>

    <!-- Between lg and 3xl there is no room for the full cluster: the star alone at
       lg, a smaller cluster from `laptop` once there's clear space beside the text. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-40 right-8 hidden lg:block laptop:hidden"
    >
      <Motif
        name="m4_brand"
        cell={13}
        loading="eager"
        motion="spin"
        dur="180s"
        reveal="pixel"
      />
    </div>
    <!-- Anchored at its own top edge (nothing crowds the nav here already),
         so the full 20% shrink comes out of the bottom, away from the bar. -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-28 right-6 hidden h-[38rem] w-[35rem] origin-[280px_40px] scale-[0.8] laptop:block 3xl:hidden"
    >
      {mid.map(({ name, cell, left, top, motion, dur, delay, rd }) => (
        <div class="absolute" style={`left:${left}px;top:${top}px`}>
          <Motif
            name={name}
            cell={cell}
            loading="eager"
            motion={motion}
            dur={dur}
            delay={delay}
            reveal="pixel"
            revealDelay={rd}
          />
        </div>
      ))}
    </div>

    <div class="relative mx-auto w-full max-w-[1160px] flex-1 px-5 pt-32 pb-16 md:px-8 md:pt-[9.375rem] xl:px-0">
      <div class="max-w-[40rem]">
        <Eyebrow data-reveal="up">{hero.eyebrow}</Eyebrow>
        <h1 class="h1-hero mt-7" data-load>
          {hero.titleLines.map((line) => (
            <>
              {line}
              <br class="hidden lg:inline" />{" "}
            </>
          ))}
          <Scribble stroke={6} spaced={false}>
            {hero.titleHighlight}
          </Scribble>
        </h1>
        <p class="lede mt-12 max-w-[34rem]" data-reveal="up" style="--d:150ms">
          {hero.intro}
        </p>
        <div
          class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-6"
          data-reveal="up"
          style="--d:300ms"
        >
          {cta && <Button href={cta.href}>{cta.label}</Button>}
          <Button href="#speakers" variant="ghost">
            {hero.secondaryCta}
          </Button>
        </div>
      </div>

      <div
        aria-hidden="true"
        class="pointer-events-none mt-14 flex flex-wrap items-end gap-x-6 gap-y-4 lg:hidden"
      >
        <Motif
          name="m4_brand"
          cell={8}
          loading="eager"
          motion="spin"
          dur="180s"
          reveal="pixel"
        />
        <Motif
          name="m3_brand"
          cell={4}
          loading="eager"
          motion="sway"
          dur="11s"
          reveal="pixel"
          revealDelay="200ms"
        />
        <Motif
          name="m5_brand"
          cell={4}
          loading="eager"
          motion="sway"
          dur="9s"
          reveal="pixel"
          revealDelay="350ms"
        />
      </div>
    </div>

    <div data-tone="ink" class="relative bg-black-pearl text-white">
      <dl
        data-reveal="up"
        style="--d:450ms"
        class="m-0 mx-auto grid max-w-[1160px] grid-cols-2 gap-x-6 gap-y-6 px-5 pt-6 pb-10 md:px-8 lg:flex lg:justify-between lg:pb-8 xl:px-0"
      >
        {hero.facts.map((fact) => (
          <div class="flex flex-col gap-1.5">
            <dt class="text-xs font-bold tracking-[0.16em] text-accent-orange uppercase">
              {fact.label}
            </dt>
            <dd class="m-0 text-base font-bold md:text-xl lg:whitespace-nowrap">
              {fact.value}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
