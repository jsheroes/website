---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import Frieze from "../ui/Frieze.astro";
import Motif from "../ui/Motif.astro";
import Scribble from "../ui/Scribble.astro";
import Section from "../ui/Section.astro";
import { editions, type TileColor } from "../../data/editions";
import { flipWall as copy } from "../../data/home";
import { cta } from "../../data/navigation";

// One group photo per edition, src/assets/flip-wall/<year>.jpg|png
const photos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/flip-wall/*.{jpg,jpeg,png}",
  { eager: true },
);
const photoFor = (year: number) => {
  const match = Object.entries(photos).find(([path]) =>
    path.split("/").pop()!.startsWith(`${year}.`),
  );
  if (!match)
    throw new Error(`FlipWall: no photo src/assets/flip-wall/${year}.*`);
  return match[1].default;
};

const tileClass: Record<TileColor, string> = {
  white: "bg-white",
  blue: "bg-dodger-blue",
  yellow: "bg-accent-orange",
  mint: "bg-accent-green",
  coral: "bg-accent-pink",
};
---

<Section
  tone="ink"
  id="editions"
  data-section="flip-wall"
  data-flip-wall
  containerClass="max-w-[1320px] pt-20 pb-24 md:pt-24"
>
  <div class="flex flex-col items-start gap-8 md:flex-row md:items-center md:gap-14">
    <Motif
      name="ten_night"
      cell={5}
      class="shrink-0 md:hidden"
      reveal="pixel"
    />
    <Motif
      name="ten_night"
      cell={7}
      class="hidden shrink-0 md:block lg:hidden"
      reveal="pixel"
    />
    <Motif
      name="ten_night"
      cell={10}
      class="hidden shrink-0 lg:block"
      reveal="pixel"
    />
    <div data-reveal="up" style="--d:150ms">
      <Eyebrow class="text-accent-orange">{copy.eyebrow}</Eyebrow>
      <h2 class="h2-section mt-4 text-white">
        {copy.titleLead} <Scribble>{copy.titleHighlight}</Scribble>{" "}
        {copy.titleTail}
      </h2>
      <div class="mt-6 flex flex-col items-start gap-6 lg:flex-row lg:items-center lg:gap-7">
        <p class="lede m-0 max-w-[35rem] text-[1.125rem]">{copy.intro}</p>
        <button
          type="button"
          data-flip-all
          class="flip-all cursor-pointer border-2 border-white bg-transparent px-5 py-3 text-[0.9375rem] font-bold whitespace-nowrap text-white hover:bg-white hover:text-black-pearl"
        >
          {copy.revealAll}
        </button>
      </div>
    </div>
  </div>

  <ul class="m-0 mt-14 grid list-none grid-cols-1 gap-2 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {editions.map((edition, i) => {
      return (
        <li
          class="flip-tile"
          data-flip-tile
          data-flipped="false"
          data-reveal="up"
          style={`--d:${(i % 4) * 80}ms`}
        >
          <div class="flip-inner">
            <div
              class:list={[
                "flip-face flip-front flex items-center justify-center text-black-pearl",
                tileClass[edition.tile],
              ]}
            >
              <Motif name={`${edition.motif}_brand`} cell={edition.motifCell} />
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="square"
                class="absolute right-4 bottom-3.5"
              >
                <path d="M4 12a8 8 0 0 1 14-5M20 12a8 8 0 0 1-14 5M18 3v4h-4M6 21v-4h4" />
              </svg>
            </div>

            <div class="flip-face flip-back flex flex-col bg-black-pearl text-white">
              <div class="relative min-h-0 flex-1 bg-[#d5dce1]">
                <Image
                  src={photoFor(edition.year)}
                  alt={`Group photo of everyone at JSHeroes ${edition.year}`}
                  widths={[480, 800]}
                  sizes="(min-width: 1024px) 320px, (min-width: 640px) 50vw, 100vw"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              </div>
              <div class="flip-caption flex h-16 shrink-0 items-center justify-between pr-3.5 pl-[1.125rem]">
                <div class="flex flex-col gap-1.5">
                  <span class="text-xl leading-none font-extrabold tracking-tight">
                    JSHeroes {edition.year}
                  </span>
                  <a
                    href={edition.playlistUrl}
                    target="_blank"
                    rel="noreferrer noopener"
                    class="text-[0.8125rem] leading-none font-semibold text-accent-orange underline decoration-accent-orange/60 decoration-1 underline-offset-4 hover:decoration-accent-orange"
                  >
                    {copy.watchHighlights} ↗
                  </a>
                </div>
                <span class="flex h-11 w-11 shrink-0 items-center justify-center bg-white">
                  <Motif name={`${edition.motif}_brand`} cell={1} />
                </span>
              </div>
            </div>
          </div>
          <button
            type="button"
            aria-pressed="false"
            class="flip-button absolute inset-0 m-0 cursor-pointer border-0 bg-transparent p-0"
          >
            <span class="sr-only">
              JSHeroes {edition.year}: show the group photo
            </span>
          </button>
        </li>
      );
    })}
  </ul>

  <div
    class="mt-14 flex flex-col items-start justify-between gap-8 sm:flex-row sm:items-center"
    data-reveal="up"
  >
    <p class="m-0 text-[clamp(1.5rem,1.1rem+1.4vw,2.25rem)] leading-tight font-extrabold tracking-tight text-white">
      {copy.footerLead}{" "}
      <span class="relative inline-block">
        {copy.footerHighlight}
        <span
          aria-hidden="true"
          class="absolute inset-x-0 -bottom-1 h-1 bg-accent-pink"
        ></span>
      </span>
    </p>
    {cta && (
      <Button href={cta.href} variant="accent" class="shrink-0">
        {cta.label}
      </Button>
    )}
  </div>

  <div slot="decor" class="absolute inset-x-0 bottom-0">
    <Frieze kind="zigzag" tone="night" />
  </div>
</Section>

<style>
  .flip-tile {
    position: relative;
    aspect-ratio: 4 / 3;
    perspective: 1400px;
  }
  .flip-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  .flip-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    backface-visibility: hidden;
  }
  .flip-back {
    transform: rotateY(180deg);
  }
  .flip-tile[data-flipped="true"] .flip-inner {
    transform: rotateY(180deg);
  }
  /* Once flipped, the flip button stops above the caption so its link stays clickable. */
  .flip-tile[data-flipped="true"] .flip-button {
    bottom: 4rem;
  }

  /* A quarter turn on hover; the motifs are symmetric, so it lands on itself. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .flip-front :global(img) {
      image-rendering: auto;
      transition: rotate 0.8s cubic-bezier(0.3, 0.7, 0.2, 1);
    }
    .flip-tile:hover .flip-front :global(img) {
      rotate: 90deg;
    }
  }

  /* Without scripting, tiles can't be flipped: show the year and photo directly. */
  @media (scripting: none) {
    .flip-front,
    .flip-button,
    .flip-all {
      display: none;
    }
    .flip-back {
      transform: none;
    }
  }

  /* Reduced motion: cross-fade instead of turning. */
  @media (prefers-reduced-motion: reduce) {
    .flip-inner {
      transform: none !important;
      transform-style: flat;
      transition: none;
    }
    .flip-face {
      backface-visibility: visible;
      transition: opacity 0.25s ease;
    }
    .flip-back {
      transform: none;
      opacity: 0;
    }
    .flip-tile[data-flipped="true"] .flip-front {
      opacity: 0;
    }
    .flip-tile[data-flipped="true"] .flip-back {
      opacity: 1;
    }
  }
</style>

<script>
  const hosts = new WeakSet<HTMLElement>();

  function init() {
    document
      .querySelectorAll<HTMLElement>("[data-flip-wall]")
      .forEach((wall) => {
        if (hosts.has(wall)) return;
        hosts.add(wall);

        const tiles = [
          ...wall.querySelectorAll<HTMLElement>("[data-flip-tile]"),
        ];
        const all = wall.querySelector<HTMLButtonElement>("[data-flip-all]");
        const labels = {
          reveal: all?.textContent?.trim() ?? "Reveal all",
          hide: "Hide all",
        };

        const set = (tile: HTMLElement, flipped: boolean) => {
          tile.dataset.flipped = String(flipped);
          tile
            .querySelector(".flip-button")
            ?.setAttribute("aria-pressed", String(flipped));
          // Only the visible face is reachable by keyboard and screen readers.
          tile.querySelector<HTMLElement>(".flip-front")!.inert = flipped;
          tile.querySelector<HTMLElement>(".flip-back")!.inert = !flipped;
        };
        const syncAll = () => {
          if (all)
            all.textContent = tiles.every((t) => t.dataset.flipped === "true")
              ? labels.hide
              : labels.reveal;
        };

        tiles.forEach((tile) => {
          set(tile, false);
          tile.querySelector(".flip-button")?.addEventListener("click", () => {
            set(tile, tile.dataset.flipped !== "true");
            syncAll();
          });
        });
        all?.addEventListener("click", () => {
          const flipAll = !tiles.every((t) => t.dataset.flipped === "true");
          tiles.forEach((tile) => set(tile, flipAll));
          syncAll();
        });
      });
  }

  // Also run now: astro:page-load only fires when the ClientRouter script loaded.
  init();
  document.addEventListener("astro:page-load", init);
</script>
