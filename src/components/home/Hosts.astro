---
import Eyebrow from "../ui/Eyebrow.astro";
import Frieze from "../ui/Frieze.astro";
import Section from "../ui/Section.astro";
import TeamCard from "./TeamCard.astro";
import { hosts as copy } from "../../data/home";
import { getPeople } from "../../utils/people";

const hosts = (await getPeople("host")).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99),
);

/** Two MCs, always: open slots show as TBA placeholders after the announced ones. */
const MC_SLOTS = 2;
const mcs = hosts.filter((host) => host.data.title === copy.mcTitle);
const mcSlots = [
  ...mcs.slice(0, MC_SLOTS),
  ...Array.from({ length: Math.max(0, MC_SLOTS - mcs.length) }, () => null),
];
const sketchArtists = hosts.filter((host) => host.data.title !== copy.mcTitle);

const label = "m-0 text-[0.8125rem] font-bold tracking-[0.16em] uppercase";
---

<Section
  tone="band"
  data-section="hosts"
  containerClass="pt-24 pb-20 md:pt-[6.5rem] md:pb-28"
>
  <div slot="decor" class="absolute inset-x-0 top-6">
    <Frieze kind="strip" cell={6} />
  </div>

  <div data-reveal="up">
    <Eyebrow>{copy.eyebrow}</Eyebrow>
    <h2 class="h2-section mt-4">{copy.title}</h2>
  </div>

  {/* Same grid as the speakers: MCs in columns 1–2, the sketch artist in column 3. */}
  <div class="host-grid mt-12 grid grid-cols-2 gap-x-4 gap-y-6 min-[480px]:gap-x-10 md:mt-14 md:gap-x-14 lg:grid-cols-4">
    <h3 class:list={[label, "col-span-2 lg:col-start-1 lg:row-start-1"]} data-reveal="up">
      {copy.mcsLabel}
    </h3>
    <ul class="contents">
      {mcSlots.map((host, i) => (
        <li
          class="mx-auto mb-4 w-full max-w-[16.25rem] lg:row-start-2"
          style={`--plate: var(${i === 0 ? "--color-accent-green" : "--color-accent-blue"}); --d:${150 + i * 110}ms`}
          data-reveal="up"
        >
          {host ? (
            <TeamCard person={host} subtitle={copy.mcLine} />
          ) : (
            <div>
              <span class="relative block aspect-[4/3]">
                <span
                  aria-hidden="true"
                  class="stepped absolute inset-0 translate-2 bg-[var(--plate)]"
                ></span>
                <span
                  aria-hidden="true"
                  class="stepped absolute inset-0 flex items-center justify-center bg-paper text-[4rem] font-extrabold tracking-tighter"
                >
                  ?
                </span>
              </span>
              <span class="mt-5 block text-xl leading-tight font-bold">{copy.tba}</span>
              <span class="mt-0.5 block text-sm text-soft">{copy.mcLine}</span>
            </div>
          )}
        </li>
      ))}
    </ul>

    <h3
      class:list={[label, "col-span-2 mt-6 lg:col-span-1 lg:col-start-3 lg:row-start-1 lg:mt-0"]}
      data-reveal="up"
    >
      {copy.sketchLabel}
    </h3>
    <ul class="contents">
      {sketchArtists.map((person) => (
        <li
          class="mx-auto mb-4 w-full max-w-[16.25rem] lg:col-start-3 lg:row-start-2"
          style="--plate: var(--color-accent-pink); --d: 370ms"
          data-reveal="up"
        >
          <TeamCard person={person} subtitle={copy.sketchLine} />
        </li>
      ))}
    </ul>

    {/* divider in the gutter between the MCs and the sketch artist */}
    <span
      aria-hidden="true"
      class="pointer-events-none relative hidden lg:col-start-3 lg:row-span-2 lg:row-start-1 lg:block"
    >
      <span class="absolute inset-y-0 -left-7 border-l-[1.5px] border-rule"></span>
    </span>
  </div>
</Section>
