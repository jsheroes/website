<button
  type="button"
  id="scroll-top"
  hidden
  class="btn btn-sm fixed right-5 bottom-5 z-20 h-11 w-11 p-0"
  aria-label="Scroll to top"
>
  <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
    <path d="M12 5l8 9h-5v5H9v-5H4z" fill="var(--color-accent-orange)"></path>
  </svg>
</button>

<script>
  // The button lives in the layout, which ClientRouter swaps on every
  // navigation, so bind per page and clean up with the page.
  document.addEventListener("astro:page-load", () => {
    const button = document.getElementById("scroll-top");
    if (!button) return;

    const update = () => {
      button.hidden = window.scrollY < 900;
    };
    button.addEventListener("click", () =>
      window.scrollTo({ top: 0, behavior: "smooth" }),
    );
    window.addEventListener("scroll", update, { passive: true });
    document.addEventListener(
      "astro:before-swap",
      () => window.removeEventListener("scroll", update),
      { once: true },
    );
    update();
  });
</script>
