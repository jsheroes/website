---
const path = Astro.url.pathname;
---

{path === "/" && (
  <>
    <link
      rel="preload"
      href="/img/logo-dark.svg"
      as="image"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/img/banners/default.svg"
      as="image"
      fetchpriority="high"
    />
    <link
      rel="preload"
      href="/img/props/bear.svg"
      as="image"
      fetchpriority="high"
    />
  </>
)}
