---
import { Image } from "astro:assets";
import male from "../../assets/bears/bear-male.svg";
import female from "../../assets/bears/bear-female.svg";

/** One of the two Ecma bears in folk costume (vector), optionally with a speech bubble.
 * The bears stay static: ambient motion is for the simple motifs only. The bubble's
 * left edge sits at --bubble-x (default 80% of the bear's width). */
export interface Props {
  who: "male" | "female";
  /** Rendered width in CSS px, sized for the old raster bears; the vectors are scaled to keep the same height. */
  width?: number;
  bubble?: string;
  class?: string;
}

const bears = {
  male: { src: male, alt: "" },
  female: { src: female, alt: "" },
};

// The vectors are a touch wider per unit of height than the old rasters were;
// these factors keep the bears slightly smaller than the raster layout height.
const fit = { male: 0.98, female: 1.03 };

const {
  who,
  width = who === "male" ? 250 : 214,
  bubble,
  class: className,
} = Astro.props;
const bear = bears[who];
const renderedWidth = Math.round(width * fit[who]);
---

<div class:list={["relative inline-block", className]} data-reveal="up">
  {bubble && (
    <p
      data-reveal="pop"
      style="--d:500ms"
      class="absolute top-[4%] left-[var(--bubble-x,80%)] z-10 m-0 border-2 border-black-pearl bg-white px-4 py-[9px] text-[1.1875rem] leading-tight font-extrabold tracking-tight whitespace-nowrap text-black-pearl shadow-[4px_4px_0_var(--color-accent-pink)]"
    >
      {bubble}
      <span
        aria-hidden="true"
        class="absolute -bottom-2.5 left-6 block h-4 w-4 rotate-45 border-r-2 border-b-2 border-black-pearl bg-white"
      />
    </p>
  )}
  <Image
    src={bear.src}
    alt={bear.alt}
    width={renderedWidth}
    class="block h-auto max-w-none"
  />
</div>
