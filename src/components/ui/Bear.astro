---
import { Image } from "astro:assets";
import male from "../../assets/bears/bear-male.png";
import female from "../../assets/bears/bear-female.png";

/** One of the two Ecma bears in folk costume, optionally with a speech bubble. */
export interface Props {
  who: "male" | "female";
  /** Rendered width in CSS px. The rasters are small, so stay under ~1.5x their size. */
  width?: number;
  bubble?: string;
  class?: string;
}

const bears = {
  male: { src: male, alt: "" },
  female: { src: female, alt: "" },
};

const {
  who,
  width = who === "male" ? 250 : 214,
  bubble,
  class: className,
} = Astro.props;
const bear = bears[who];
---

<div class:list={["relative inline-block", className]} data-reveal="up">
  {bubble && (
    <p
      data-reveal="pop"
      style="--d:500ms"
      class="absolute top-[4%] left-[80%] z-10 m-0 border-2 border-black-pearl bg-white px-4 py-[9px] text-[1.1875rem] leading-tight font-extrabold tracking-tight whitespace-nowrap text-black-pearl shadow-[4px_4px_0_var(--color-accent-pink)]"
    >
      {bubble}
      <span
        aria-hidden="true"
        class="absolute -bottom-2.5 left-6 block h-4 w-4 rotate-45 border-r-2 border-b-2 border-black-pearl bg-white"
      />
    </p>
  )}
  <Image
    src={bear.src}
    alt={bear.alt}
    width={width}
    densities={[1, 1.5]}
    class="block h-auto max-w-none"
    data-motion="sway-soft"
    style="--dur:5s"
  />
</div>
