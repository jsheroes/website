---
import type { ImageMetadata } from "astro";

/**
 * A pixel motif from src/assets/motifs, rendered at a whole number of CSS
 * pixels per cell so the edges stay crisp. Names look like `m4_brand`,
 * `pd_coral`, `st_night`: the suffix picks the palette (brand on light
 * surfaces, night on ink).
 */
export interface Props {
  name: string;
  /** CSS pixels per motif cell. */
  cell?: number;
  class?: string;
  /** Leave empty for decoration, which is nearly always the case. */
  alt?: string;
  flip?: boolean;
  /** Motifs above the fold should pass "eager". */
  loading?: "lazy" | "eager";
  /** Ambient movement: see assets/motion.css. Spins and sways use smooth resampling. */
  motion?: "spin" | "spin-rev" | "sway" | "bob" | "twinkle";
  /** Animation duration, e.g. "90s". */
  dur?: string;
  /** Animation delay; negative values start mid-cycle so neighbours are out of step. */
  delay?: string;
  /** Reveal on scroll: "pixel" unfolds the motif from its centre in steps. */
  reveal?: "pixel";
  /** Delay before the reveal, e.g. "200ms". */
  revealDelay?: string;
}

const motifs = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/motifs/*.svg",
  { eager: true },
);

const {
  name,
  cell = 8,
  class: className,
  alt = "",
  flip = false,
  loading = "lazy",
  motion,
  dur,
  delay,
  reveal,
  revealDelay,
} = Astro.props;

const motif = motifs[`/src/assets/motifs/${name}.svg`]?.default;
if (!motif) throw new Error(`Unknown motif "${name}"`);
---

{motion || reveal ? (
  <span
    class:list={["block", { "-scale-x-100": flip }, className]}
    data-reveal={reveal}
    style={revealDelay ? `--d:${revealDelay}` : undefined}
  >
    <img
      src={motif.src}
      width={motif.width * cell}
      height={motif.height * cell}
      alt={alt}
      aria-hidden={alt === "" ? "true" : undefined}
      class="block max-w-none [image-rendering:pixelated]"
      loading={loading}
      decoding="async"
      data-motion={motion}
      style={
        [dur && `--dur:${dur}`, delay && `--delay:${delay}`]
          .filter(Boolean)
          .join(";") || undefined
      }
    />
  </span>
) : (
  <img
    src={motif.src}
    width={motif.width * cell}
    height={motif.height * cell}
    alt={alt}
    aria-hidden={alt === "" ? "true" : undefined}
    class:list={[
      "block max-w-none [image-rendering:pixelated]",
      { "-scale-x-100": flip },
      className,
    ]}
    loading={loading}
    decoding="async"
  />
)}
