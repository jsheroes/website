---
import type { ImageMetadata } from "astro";

/**
 * A full-width pixel border. Diamond and zigzag are one 12-cell repeat tiled
 * with repeat-x, so they fit any width. The strip is a row of assorted motifs
 * used as ground and divider.
 */
export interface Props {
  kind?: "diamond" | "zigzag" | "strip";
  /** brand on light surfaces, night on ink. */
  tone?: "brand" | "night";
  /** CSS pixels per motif cell. */
  cell?: number;
  class?: string;
}

const units = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/motifs/{frieze-*,strip_*}.svg",
  { eager: true },
);

const {
  kind = "diamond",
  tone = "brand",
  cell = 4,
  class: className,
} = Astro.props;

const file = kind === "strip" ? `strip_${tone}` : `frieze-${kind}_${tone}`;
const unit = units[`/src/assets/motifs/${file}.svg`]?.default;
if (!unit) throw new Error(`Unknown frieze "${file}"`);
---

<div
  aria-hidden="true"
  class:list={["w-full [image-rendering:pixelated]", className]}
  style={`height:${unit.height * cell}px;background:url(${unit.src}) repeat-x left top / ${unit.width * cell}px ${unit.height * cell}px`}
></div>
