---
import type { HTMLAttributes } from "astro/types";

/** Outlined label or filter. As a link it lifts on hover; `active` fills it with ink. */
interface Props extends HTMLAttributes<"a"> {
  href?: string;
  active?: boolean;
  size?: "sm" | "md";
}

const {
  href,
  active = false,
  size = "md",
  class: className,
  ...rest
} = Astro.props;

const classes = [
  "inline-block border-2 border-black-pearl leading-tight font-semibold no-underline",
  size === "sm" ? "px-3 py-1 text-[0.8125rem]" : "px-4 py-2 text-[0.9375rem]",
  active ? "bg-black-pearl text-white" : "bg-white text-black-pearl",
  href && !active
    ? "transition hover:-translate-y-0.5 hover:shadow-[3px_3px_0_var(--color-accent-pink)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
    : "",
  className,
];
---

{href ? (
  <a
    href={href}
    aria-current={active ? "page" : undefined}
    class:list={classes}
    {...rest}
  >
    <slot />
  </a>
) : (
  <span class:list={classes}>
    <slot />
  </span>
)}
