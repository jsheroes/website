---
import BearLink from "../components/BearLink.astro";
import { event } from "../data/event";

export interface Props {
  variant?: "sponsor" | "default";
}

const { variant = "default" } = Astro.props as Props;

const subTitle =
  variant === "default"
    ? "An all things JavaScript conference"
    : "The biggest dev community event in Romania";
---

<div class="relative flex h-screen items-center justify-center bg-brand-darknavy">
  <video
    preload="true"
    autoplay
    loop
    muted
    playsinline
    class="h-full w-full object-cover"
  >
    <source src="/movie-cut.mp4" type="video/mp4" />
  </video>

  <div class="absolute inset-0 bg-gradient-to-b from-[#0b1b4480] from-50% to-brand-darknavy to-90%">
    <span class="hidden md:block bear-anchor absolute right-[160px] bottom-[-100px] z-10 animate-none lg:animate-bear-float">
      <BearLink animation="scale" />
    </span>
  </div>

  <div class="absolute w-full px-4 md:px-8">
    <div class="flex flex-col items-start max-w-[1280px] m-auto gap-8 font-display text-neutral-light">
      <div class="space-y-3">
        <img src="/img/logo-dark.svg" alt="JSHeroes" class="w-[21rem]" />
        <h1 class="text-md">{subTitle}</h1>
      </div>

      <div>
        <h2 class="text-lg flex flex-wrap gap-0 sm:gap-1">
          <span>We're coming back in {event.year}!</span>
        </h2>
        <p class="text-md">in the heart of Transylvania ❤️</p>
      </div>
      <div>
        <p class="text-xl font-medium">{event.dates}</p>
        <p class="text-md">
          {event.venue.city}, {event.venue.country}
        </p>
      </div>
      {variant === "default" && (
        <a
          href={event.ticketsUrl}
          target="_blank"
          rel="noreferrer noopener"
          class="cta-button"
        >
          Join the waitlist
        </a>
      )}
    </div>
  </div>
</div>
