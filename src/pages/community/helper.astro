---
import Button from "../../components/ui/Button.astro";
import Section from "../../components/ui/Section.astro";
import PageLayout from "../../layouts/PageLayout.astro";
---

<PageLayout
  title="Community Helper"
  eyebrow="Community"
  intro="Things we hand out to communities that partner with us."
>
  <Section containerClass="pt-6 pb-20 md:pt-10 md:pb-28">
    <ul class="m-0 grid list-none gap-10 p-0 md:grid-cols-2">
      <li class="flex flex-col items-start gap-4 border-t-[1.5px] border-rule pt-6">
        <h2 class="m-0 text-2xl font-extrabold tracking-tight">
          The Community Banner
        </h2>
        <Button href="/img/banners/community-banner.png" variant="ghost">
          Open the banner
        </Button>
      </li>
      <li class="flex flex-col items-start gap-4 border-t-[1.5px] border-rule pt-6">
        <h2 class="m-0 text-2xl font-extrabold tracking-tight">
          The Slack Code
        </h2>
        <Button href="/img/slack/qr.png" variant="ghost">
          Open the Slack QR
        </Button>
      </li>
    </ul>
  </Section>
</PageLayout>
