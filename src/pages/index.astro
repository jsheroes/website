---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";

import Hero from "../components/home/Hero.astro";
import Speakers from "../components/home/Speakers.astro";
import Hosts from "../components/home/Hosts.astro";
import FlipWall from "../components/home/FlipWall.astro";
import Agenda from "../components/home/Agenda.astro";
import Venue from "../components/home/Venue.astro";
import Community from "../components/home/Community.astro";
import Friends from "../sections/friends.astro";
import Organizers from "../sections/organizers.astro";
---

<BaseLayout>
  <main id="main" class="v2">
    <Hero />
    <Speakers />
    <Hosts />
    <FlipWall />
    <Agenda />
    <Venue />
    <Community />

    <!-- Not redesigned yet: sponsors and team. -->
    <div class="legacy">
      <Section id="sponsors" variant="light" content="list">
        <Friends />
      </Section>
      <Section id="team" variant="dark" content="list">
        <Organizers />
      </Section>
    </div>
  </main>
</BaseLayout>
