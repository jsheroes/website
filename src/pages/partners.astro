---
import { Image } from "astro:assets";
import CtaBand from "../components/ui/CtaBand.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import PhotoStrip from "../components/ui/PhotoStrip.astro";
import Section from "../components/ui/Section.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { communities } from "../data/communities";

const withDiscounts = communities.filter((c) => c.discount);
---

<PageLayout
  title="Partner Communities"
  eyebrow="Community"
  intro="Communities we learn with and from. Members of JSHeroes get exclusive discounts on their events."
>
  <PhotoStrip
    names={["event/community1.jpg", "event/merch1.jpg", "event/community7.jpg"]}
  />

  {withDiscounts.length > 0 && (
    <Section containerClass="py-16 md:py-24">
      <Eyebrow data-reveal="up">Members only</Eyebrow>
      <h2 class="h2-section mt-5" data-reveal="up" style="--d:80ms">
        Exclusive partner discounts
      </h2>
      <p class="lede mt-6 max-w-[38rem]" data-reveal="up" style="--d:140ms">
        Use these discount codes when purchasing tickets for our partner events.
        These offers are exclusively for JSHeroes community members.
      </p>

      <ul class="m-0 mt-12 grid list-none grid-cols-1 gap-6 p-0 md:grid-cols-2">
        {withDiscounts.map((community, i) => (
          <li data-reveal="up" style={`--d:${(i % 2) * 90}ms`}>
            <a
              href={community.url}
              target="_blank"
              rel="noreferrer noopener"
              class="group flex h-full flex-col border-2 border-black-pearl bg-white no-underline transition hover:-translate-y-0.5 hover:shadow-[5px_5px_0_var(--color-accent-orange)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
            >
              <span
                class="flex h-36 items-center justify-center border-b-2 border-black-pearl p-6"
                style={`background-color:${community.overrideBgColor ?? "#ffffff"}`}
              >
                <Image
                  src={community.logo}
                  alt=""
                  width={280}
                  densities={[1, 2]}
                  class="max-h-24 w-auto max-w-full object-contain"
                />
              </span>
              <span class="flex flex-1 flex-col gap-4 p-5">
                <span class="flex items-center justify-between gap-4">
                  <span class="text-xl font-bold group-hover:underline group-hover:decoration-accent-pink group-hover:decoration-2 group-hover:underline-offset-4">
                    {community.name}
                  </span>
                  <span class="shrink-0 bg-accent-orange px-3 py-1 text-sm font-bold">
                    {community.discount!.percentage}% off
                  </span>
                </span>
                <span class="mt-auto border-t-[1.5px] border-rule pt-4">
                  <span class="block text-xs font-bold tracking-[0.16em] text-muted-strong uppercase">
                    Discount code
                  </span>
                  <code class="mt-2 block bg-black-pearl px-4 py-2 font-mono text-lg font-bold tracking-wider text-accent-orange">
                    {community.discount!.code}
                  </code>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <CtaBand
    title="Spread the love for communities"
    cta={{ label: "Get in touch", href: "mailto:welcome@jsheroes.io" }}
    bear="female"
    bubble="Hai cu noi!"
  >
    <p class="m-0">
      If your community would like to partner with JSHeroes, we'd love to hear
      from you! Reach out to us and let's explore how we can support each other.
    </p>
  </CtaBand>
</PageLayout>
