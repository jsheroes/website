---
import CtaBand from "../components/ui/CtaBand.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Feature from "../components/ui/Feature.astro";
import Motif from "../components/ui/Motif.astro";
import PhotoStrip from "../components/ui/PhotoStrip.astro";
import Section from "../components/ui/Section.astro";
import PageLayout from "../layouts/PageLayout.astro";
import {
  BENEFITS_INFO,
  BRONZE_PACKAGE,
  GOLD_PACKAGE,
  SILVER_PACKAGE,
  SUPPORTER_PACKAGE,
} from "../data/packages";

const stats = [
  {
    value: "350",
    label: "attendees",
    note: "30% international audience",
    color: "var(--color-accent-pink)",
  },
  {
    value: "16",
    label: "speakers",
    note: "from all over the world",
    color: "var(--color-dodger-blue)",
  },
  {
    value: "2",
    label: "days",
    note: "14 hours of quality content",
    color: "var(--color-accent-green)",
  },
  {
    value: "3K",
    label: "members",
    note: "local community members",
    color: "var(--color-accent-orange)",
  },
  {
    value: "10K",
    label: "followers",
    note: "across our social media channels",
    color: "var(--color-accent-green)",
  },
  {
    value: "3.8K",
    label: "subscribers",
    note: "on our YouTube channel",
    color: "var(--color-accent-pink)",
  },
];

const packages = [
  GOLD_PACKAGE,
  SILVER_PACKAGE,
  BRONZE_PACKAGE,
  SUPPORTER_PACKAGE,
];
const accents: Record<string, { color: string; marker: string }> = {
  "accent-pink": { color: "var(--color-accent-pink)", marker: "pd_coral" },
  "accent-green": { color: "var(--color-accent-green)", marker: "pd_mint" },
  "accent-orange": { color: "var(--color-accent-orange)", marker: "pd_yel" },
  rule: { color: "var(--color-rule)", marker: "pd_gray" },
};

const testimonials = [
  {
    name: "Maarten van Hoof",
    role: "Devops Engineer Frontend @ Essent",
    photo: "/img/sponsors-page/maarten.jpg",
    tint: "var(--color-tint-blue)",
    quote: [
      "If there is one conference that you already should put on your shortlist for (the) next year(s), JSHeroes is the one.",
      "From seasoned veterans to emerging talents, the line-up every year is a true reflection of the Web community's diversity and innovation. The above-and-beyond hospitality of the organization, the diverse range of international attendees, and the focus on inclusiveness, makes JSHeroes Conference one of the top conferences in Europe.",
    ],
  },
  {
    name: "Natalia Tepluhina",
    role: "Principal Engineer @ Gitlab",
    photo: "/img/sponsors-page/natalia-tepluhina.jpg",
    tint: "var(--color-tint-coral)",
    quote: [
      "People just start talking about their pains in the code business. It's amazing! It feels like a group therapy, in a way. And this is something you cannot replace when doing online events.",
    ],
  },
];
---

<PageLayout
  title="Sponsors welcome!"
  eyebrow="Sponsors"
  highlight="welcome"
  intro="What started as a small idea from the local JavaScript community, evolved into one of the best community-organized events in Europe."
>
  <Section tone="band" containerClass="py-16 md:py-24">
    <ul class="m-0 grid list-none grid-cols-1 gap-x-10 gap-y-12 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {stats.map((stat, i) => (
        <li
          class="border-t-[6px] pt-5"
          style={`border-color:${stat.color};--d:${(i % 3) * 90}ms`}
          data-reveal="up"
        >
          <p class="m-0 text-[clamp(3.5rem,2.5rem+4vw,5.5rem)] leading-none font-extrabold tracking-tighter">
            {stat.value}
          </p>
          <p class="m-0 mt-2 text-xl font-bold">{stat.label}</p>
          <p class="m-0 text-soft">{stat.note}</p>
        </li>
      ))}
    </ul>
  </Section>

  <PhotoStrip
    names={["event/sponsor5.jpg", "event/sponsor6.jpg", "event/sponsor7.jpg"]}
  />

  <Section tone="ink" containerClass="py-16 md:py-24">
    <Eyebrow data-reveal="up" class="text-accent-orange">
      Why us
    </Eyebrow>
    <h2
      class="h2-section mt-5 mb-12 text-white"
      data-reveal="up"
      style="--d:80ms"
    >
      Why should you sponsor us?
    </h2>
    <div class="grid gap-x-16 gap-y-12 md:grid-cols-2">
      <Feature title="Exposure to a dedicated community" tone="coral">
        <p class="m-0">
          Community events get the best out of people that want to share ideas,
          network or find new opportunities. You can expect a balanced mix of
          seasoned professionals and fast growing beginners to come in contact
          with your company.
        </p>
      </Feature>
      <Feature title="Brand association" tone="blue">
        <p class="m-0">
          Over the past 10 years, JSHeroes has grown into one of the most{" "}
          <strong>recognizable</strong> brands in the JavaScript community
          worldwide. Your company will benefit from being showcased on our
          visuals and video recordings.
        </p>
      </Feature>
      <Feature title="Contribute to the growth of the community" tone="yellow">
        <p class="m-0">
          We strongly believe that JavaScript is the future. Therefore, our
          mission is to <strong>grow</strong> together with the community.
          Through JSHeroes, we aim to keep everyone in sync with the latest
          advancements and trends in the world of JavaScript and web
          development.
        </p>
      </Feature>
      <Feature title="Support a non-profit and transparent event" tone="mint">
        <p class="m-0">
          We embraced the <strong>open source</strong> model from the beginning.
          All the details about the event are public and our budget and expenses
          are published after each event on{" "}
          <a
            href="/transparency"
            class="font-bold underline decoration-accent-orange decoration-2 underline-offset-4"
          >
            our transparency page
          </a>
          .
        </p>
      </Feature>
    </div>
  </Section>

  <Section containerClass="py-16 md:py-24">
    <Eyebrow data-reveal="up">Packages</Eyebrow>
    <h2 class="h2-section mt-5 mb-12" data-reveal="up" style="--d:80ms">
      Sponsor packages
    </h2>

    <ul class="m-0 grid list-none grid-cols-1 gap-8 p-0 lg:grid-cols-2">
      {packages.map((pkg, i) => {
        const accent = accents[pkg.color] ?? accents.rule;
        const soldOut = pkg.availability === 0;
        return (
          <li data-reveal="up" style={`--d:${(i % 2) * 100}ms`}>
            <article
              class:list={[
                "flex h-full flex-col border-2 border-black-pearl bg-white",
                { "opacity-70 grayscale": soldOut },
              ]}
            >
              <div class="h-2" style={`background:${accent.color}`}></div>
              <div class="flex flex-1 flex-col gap-6 p-6 md:p-8">
                <header class="flex flex-col items-start gap-2">
                  <h3 class="m-0 text-3xl leading-none font-extrabold tracking-tight">
                    {pkg.name} package
                  </h3>
                  <p class="m-0 text-4xl leading-none font-extrabold tracking-tighter">
                    {pkg.price.toLocaleString("en-US")} €
                  </p>
                  <p class="m-0 max-w-[35ch] text-soft">{pkg.description}</p>
                  <p
                    class="m-0 mt-1 inline-block px-3 py-1 text-xs font-bold tracking-[0.12em] uppercase"
                    style={`background:${accent.color}`}
                  >
                    {soldOut
                      ? "Sold out"
                      : `${pkg.availability} ${pkg.availability === 1 ? "package" : "packages"} left`}
                  </p>
                </header>
                <ul class="m-0 flex list-none flex-col gap-3 border-t-[1.5px] border-rule p-0 pt-6">
                  {pkg.benefits.map((benefit) => {
                    const info = BENEFITS_INFO[benefit];
                    return (
                      <li class="flex items-start gap-3">
                        <Motif
                          name={accent.marker}
                          cell={4}
                          class="mt-[0.1rem] shrink-0"
                        />
                        <span>
                          <span
                            class:list={[
                              pkg.highlightedBenefits.includes(benefit)
                                ? "font-bold"
                                : "font-normal",
                            ]}
                          >
                            {info.display}
                          </span>
                          {info.explanation && (
                            <span
                              class="mt-0.5 block text-sm text-muted-strong"
                              set:html={info.explanation}
                            />
                          )}
                          {info.link && (
                            <a
                              href={info.link}
                              target="_blank"
                              rel="noreferrer noopener"
                              class="mt-0.5 inline-flex items-center gap-1 text-sm font-bold no-underline hover:text-accent-pink"
                            >
                              See an example ↗
                            </a>
                          )}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
  </Section>

  <PhotoStrip
    names={["event/sponsor1.jpg", "event/sponsor2.jpg", "event/sponsor3.jpg"]}
  />

  <Section containerClass="py-16 md:py-24">
    <Eyebrow data-reveal="up">Kind words</Eyebrow>
    <h2 class="h2-section mt-5 mb-12" data-reveal="up" style="--d:80ms">
      What speakers say
    </h2>
    <div class="grid gap-12 md:grid-cols-2">
      {testimonials.map((t, i) => (
        <figure
          class="m-0 flex flex-col gap-6"
          data-reveal="up"
          style={`--d:${i * 100}ms`}
        >
          <blockquote class="m-0 flex flex-col gap-4 border-l-[6px] border-accent-pink pl-6 text-lg leading-relaxed">
            {t.quote.map((paragraph) => (
              <p class="m-0">{paragraph}</p>
            ))}
          </blockquote>
          <figcaption class="flex items-center gap-4">
            <img
              src={t.photo}
              alt=""
              width="72"
              height="72"
              loading="lazy"
              class="h-[4.5rem] w-[4.5rem] object-cover mix-blend-multiply grayscale"
              style={`background:${t.tint}`}
            />
            <span>
              <strong class="block text-lg">{t.name}</strong>
              <span class="text-soft">{t.role}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </Section>

  <CtaBand
    title="Let's talk sponsorship"
    cta={{ label: "welcome@jsheroes.io", href: "mailto:welcome@jsheroes.io" }}
    bear="male"
    bubble="Join us!"
  >
    <p class="m-0">
      Alexandra Retegan will help you pick the right package.
      <br />
      <a href="tel:0040756403372" class="font-bold">
        +4 0756 403 372
      </a>
    </p>
  </CtaBand>
</PageLayout>
