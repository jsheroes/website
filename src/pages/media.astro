---
import { YouTube } from "@astro-community/astro-embed-youtube";
import Button from "../components/ui/Button.astro";
import Chip from "../components/ui/Chip.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Section from "../components/ui/Section.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { event } from "../data/event";

const nav = [
  ["About JSHeroes", "#about"],
  ["Logos & Brand", "#brand"],
  ["Typeface", "#typeface"],
  ["Image Gallery", "#image-gallery"],
  ["Video Gallery", "#video-gallery"],
];

const primary = [
  {
    name: "Dodger Blue",
    hex: "#0098FF",
    rgb: "R0 G152 B255",
    cmyk: "C1 M0.40 Y0 K0",
    token: "var(--color-dodger-blue)",
    ink: false,
  },
  {
    name: "Black Pearl",
    hex: "#001C2B",
    rgb: "R0 G28 B43",
    cmyk: "C1 M0.35 Y0 K0.83",
    token: "var(--color-black-pearl)",
    ink: true,
  },
  {
    name: "Pure White",
    hex: "#FFFFFF",
    rgb: "R255 G255 B255",
    cmyk: "C0 M0 Y0 K0",
    token: "#fff",
    ink: false,
  },
];
const secondary = [
  {
    name: "Grandis",
    hex: "#FFCC67",
    rgb: "R255 G204 B103",
    cmyk: "C0 M0.2 Y0.60 K0",
    token: "var(--color-accent-orange)",
    ink: false,
  },
  {
    name: "Downy",
    hex: "#65D3BB",
    rgb: "R101 G211 B187",
    cmyk: "C0.52 M0 Y0.11 K0.17",
    token: "var(--color-accent-green)",
    ink: false,
  },
  {
    name: "Wild Watermelon",
    hex: "#FF6078",
    rgb: "R255 G96 B120",
    cmyk: "C0 M0.62 Y0.53 K0",
    token: "var(--color-accent-pink)",
    ink: false,
  },
];

const gallery = [
  {
    year: 2024,
    photo: "jsh-2024.png",
    url: "https://drive.google.com/drive/u/0/folders/1-7M0b6rgvFBb4vAasUfa3RfVV_296AR4",
  },
  {
    year: 2023,
    photo: "jsh-2023.jpg",
    url: "https://drive.google.com/drive/u/0/folders/1FyZhZreQWiCossqJOCOx1w0LJ2SZmWL-",
  },
  {
    year: 2022,
    photo: "jsh-2022.png",
    url: "https://drive.google.com/drive/folders/1TxUO0ArQMC65mBfWPFrklNsren1I8nHl",
  },
  {
    year: 2019,
    photo: "jsh-2019.png",
    url: "https://drive.google.com/drive/folders/1dA_XDg9kUhyjIlV3HuekPEE4NG2M7tju",
  },
  {
    year: 2018,
    photo: "jsh-2018.png",
    url: "https://drive.google.com/drive/folders/1Bhl8xiXQkvh2SZyREfC0SeGsUUYgk7qf",
  },
];
const videos = ["N6qr6L37sl8", "munltx48_xI", "jdr9eQGq97g", "Zx2moTy-yAg"];
const weights = [
  ["Regular", 400],
  ["Medium", 500],
  ["Bold", 700],
  ["ExtraBold", 800],
] as const;
---

<PageLayout
  title="JSHeroes Media Kit"
  eyebrow="Press"
  highlight="Kit"
  intro="Everything you need to write about JSHeroes: who we are, our logos, colours and mascots, and photos and videos from past editions."
>
  <Section containerClass="pt-2 pb-6 md:pt-4">
    <nav aria-label="On this page">
      <ul class="m-0 flex list-none flex-wrap gap-3 p-0">
        {nav.map(([label, href]) => (
          <li>
            <Chip href={href}>{label}</Chip>
          </li>
        ))}
      </ul>
    </nav>
  </Section>

  <Section id="about" containerClass="py-14 md:py-20">
    <Eyebrow data-reveal="up">Who we are</Eyebrow>
    <h2 class="h2-section mt-5 mb-8" data-reveal="up" style="--d:80ms">
      About JSHeroes
    </h2>
    <div class="prose max-w-[65ch]">
      <p>
        <strong>JSHeroes</strong> is a yearly event organised by the local
        JavaScript community in Cluj, Romania. Our journey started in 2017 with
        a plan: for JSHeroes to be the biggest tech conference in Romania,
        dedicated solely to <strong>JavaScript</strong>. This year, {event.year}{" "}
        (our {event.editionOrdinal} edition) we have chosen a venue that can
        accommodate up to <strong>600 attendees</strong>. Join us on{" "}
        <strong>{event.dates}</strong>, in {event.venue.city}, Romania.
      </p>
      <p>
        <strong>JSHeroes</strong> is a non-profit community-organised
        conference. Our goal is to bring together <strong>JS</strong> and{" "}
        <strong>Web/Frontend</strong>
        development enthusiasts from all over the world for a{" "}
        <strong>two-day</strong> event with: great talks, amazing networking and
        tons of fun. You bring your ideas and desire to learn, we provide the
        relaxed atmosphere and the good vibes.
      </p>
      <p>
        We believe that the <strong>community</strong> and the{" "}
        <strong>open-source</strong> models are well suited for our core values:
        learning, teaching and knowledge sharing. Our mission is to inspire
        other communities with the concept of open-source events.
      </p>
      <p>
        We are publishing all data about this conference, in{" "}
        <a href="/transparency">full transparency</a>. We are also available at
        any time for inquires and we are really looking forward to sharing our
        knowledge about organising international events. This way, whenever a
        community wants to start something similar, they can build on our
        knowledge.
      </p>
    </div>
  </Section>

  <Section id="brand" tone="band" containerClass="py-14 md:py-20">
    <Eyebrow data-reveal="up">Identity</Eyebrow>
    <h2 class="h2-section mt-5 mb-8" data-reveal="up" style="--d:80ms">
      Logos & Brand
    </h2>

    <div class="prose max-w-[65ch]">
      <p>
        When using the <strong>JSHeroes brand</strong>:
      </p>
      <ul>
        <li>Please don't edit or recolor the logo.</li>
        <li>
          The JSHeroes logo likes a little elbow room, so don't place copy or
          graphic element in close proximity.
        </li>
        <li>
          Please don't use our name or logo in ways that may be misleading or
          suggest endorsement by JSHeroes of your product or service.
        </li>
        <li>
          JSHeroes reserves the right to terminate or modify any use of the
          logo.
        </li>
      </ul>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <figure class="m-0" data-reveal="up">
        <div class="flex h-40 items-center justify-center border-2 border-black-pearl bg-white p-8">
          <img
            src="/img/logo-light.svg"
            alt="JSHeroes logo for white backgrounds"
            class="max-h-full w-auto"
          />
        </div>
        <figcaption class="mt-3 text-sm text-soft">
          On white backgrounds, use the blue-black JSHeroes logo which is our
          primary brand mark.
        </figcaption>
      </figure>
      <figure class="m-0" data-reveal="up" style="--d:90ms">
        <div class="flex h-40 items-center justify-center border-2 border-black-pearl bg-black-pearl p-8">
          <img
            src="/img/logo-dark.svg"
            alt="JSHeroes logo for dark backgrounds"
            class="max-h-full w-auto"
          />
        </div>
        <figcaption class="mt-3 text-sm text-soft">
          On coloured or photo backgrounds, use the blue-white JSHeroes logo.
        </figcaption>
      </figure>
    </div>
    <div class="mt-8">
      <Button
        href="https://drive.google.com/drive/folders/1sofbnmpPLksST8QNsiWuXIbKJ3KO-w06"
        class="[--btn-shadow:var(--color-accent-orange)]"
      >
        Download all logos
      </Button>
    </div>

    <h3 class="mt-20 mb-4 text-3xl font-extrabold tracking-tight">Ecma</h3>
    <p class="m-0 max-w-[65ch] text-soft">
      Mr. and Ms. Ecma the bears are the brand mascots of JSHeroes.
    </p>
    <ul class="m-0 mt-8 flex list-none flex-wrap items-end gap-x-12 gap-y-8 p-0">
      <li>
        <img
          src="/img/props/hello-bear.svg"
          alt="Ecma, JSHeroes mascot wearing a space suit and waving"
          class="h-56 w-auto"
          loading="lazy"
        />
      </li>
      <li>
        <img
          src="/img/props/traditional-bear.svg"
          alt="Ecma, JSHeroes Mr. bear mascot"
          class="h-56 w-auto"
          loading="lazy"
        />
      </li>
      <li>
        <img
          src="/img/props/ms-bear.svg"
          alt="Ecma, JSHeroes Mrs. bear mascot"
          class="h-56 w-auto"
          loading="lazy"
        />
      </li>
    </ul>
    <div class="mt-8">
      <Button
        href="https://drive.google.com/drive/folders/10h4YfifW5DJRn7Cc5nnOsDa78E359C-m"
        class="[--btn-shadow:var(--color-accent-orange)]"
      >
        Download Ecma visuals
      </Button>
    </div>

    <h3 class="mt-20 mb-4 text-3xl font-extrabold tracking-tight">
      Brand colors
    </h3>
    <div class="prose max-w-[65ch]">
      <p>
        Our Primary Brand Colors include all the following colors found in our
        logo. Similarly, the Secondary Colors, although not included in our logo
        support and go very nicely with the Primary Brand Colors.
      </p>
      <p>
        We request you to use the exact colors so as to maintain consistency in
        brand representation.
      </p>
      <p>
        <strong>Colors:</strong> RGB for web, CMYK for print
      </p>
    </div>

    {[
      ["Primary colors", primary],
      ["Secondary colors", secondary],
    ].map(([title, colors]) => (
      <>
        <h4 class="mt-10 mb-4 text-[0.8125rem] font-bold tracking-[0.16em] uppercase">
          {title}
        </h4>
        <ul class="m-0 grid list-none grid-cols-1 gap-6 p-0 sm:grid-cols-3">
          {(colors as typeof primary).map((color) => (
            <li data-reveal="up">
              <div
                class="h-32 border-2 border-black-pearl"
                style={`background:${color.token}`}
              ></div>
              <dl class="m-0 mt-3 text-sm">
                <dt class="font-bold">{color.name}</dt>
                <dd class="m-0 text-soft">{color.hex}</dd>
                <dd class="m-0 text-soft">{color.rgb}</dd>
                <dd class="m-0 text-soft">{color.cmyk}</dd>
              </dl>
            </li>
          ))}
        </ul>
      </>
    ))}
  </Section>

  <Section id="typeface" containerClass="py-14 md:py-20">
    <Eyebrow data-reveal="up">Type</Eyebrow>
    <h2 class="h2-section mt-5 mb-8" data-reveal="up" style="--d:80ms">
      Typeface
    </h2>
    <p class="m-0 max-w-[65ch] text-soft">
      The font we use on the website and print materials is called{" "}
      <strong class="text-black-pearl">Sora</strong>. Regular, Medium, Bold and
      ExtraBold are used.
    </p>
    <ul class="m-0 mt-10 grid list-none grid-cols-1 gap-x-10 gap-y-6 p-0 sm:grid-cols-2">
      {weights.map(([name, weight]) => (
        <li class="border-t-[1.5px] border-rule pt-4">
          <p
            class="m-0 text-5xl leading-none tracking-tight"
            style={`font-weight:${weight}`}
          >
            Aa
          </p>
          <p class="m-0 mt-2 text-sm text-soft">
            {name} · {weight}
          </p>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="image-gallery" tone="band" containerClass="py-14 md:py-20">
    <Eyebrow data-reveal="up">Photos</Eyebrow>
    <h2 class="h2-section mt-5 mb-6" data-reveal="up" style="--d:80ms">
      Image Gallery
    </h2>
    <div class="prose max-w-[65ch]">
      <p>The Gallery contains images from our latest 5 editions.</p>
      <p>
        Images are available for editorial purposes only, credits must be
        includes. Download is not allowed for commercial use.
      </p>
    </div>
    <ul class="m-0 mt-10 grid list-none grid-cols-1 gap-8 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {gallery.map((item, i) => (
        <li data-reveal="up" style={`--d:${(i % 3) * 80}ms`}>
          <a
            href={item.url}
            target="_blank"
            rel="noreferrer noopener"
            class="group block no-underline"
          >
            <img
              src={`/img/gallery/${item.photo}`}
              alt=""
              width="384"
              height="246"
              loading="lazy"
              class="aspect-[384/246] w-full border-2 border-black-pearl object-cover"
            />
            <span class="mt-3 block text-lg font-bold group-hover:underline group-hover:decoration-accent-pink group-hover:decoration-2 group-hover:underline-offset-4">
              JSHeroes {item.year}
            </span>
            <span class="text-sm text-soft">Open the photo folder ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="video-gallery" containerClass="py-14 md:py-20">
    <Eyebrow data-reveal="up">Video</Eyebrow>
    <h2 class="h2-section mt-5 mb-6" data-reveal="up" style="--d:80ms">
      Video Gallery
    </h2>
    <p class="m-0 max-w-[65ch] text-soft">
      When using the videos, please mention the source JSHeroes. Download is not
      allowed for commercial use.
    </p>
    <ul class="m-0 mt-10 grid list-none grid-cols-1 gap-8 p-0 md:grid-cols-2">
      {videos.map((id) => (
        <li>
          <YouTube id={id} class="w-full" />
        </li>
      ))}
    </ul>
  </Section>
</PageLayout>
