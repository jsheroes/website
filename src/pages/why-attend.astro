---
import Eyebrow from "../components/ui/Eyebrow.astro";
import CtaBand from "../components/ui/CtaBand.astro";
import Feature from "../components/ui/Feature.astro";
import PhotoStrip from "../components/ui/PhotoStrip.astro";
import Section from "../components/ui/Section.astro";
import PageLayout from "../layouts/PageLayout.astro";
import { event } from "../data/event";
import { cta } from "../data/navigation";

const groups = [
  {
    eyebrow: "Grow",
    title: "Fast-forward your career",
    tone: "paper" as const,
    items: [
      [
        "World-class speakers",
        "Learn from industry leaders and innovators who are shaping the future of JavaScript and the web platform.",
      ],
      [
        "Hands-on experience",
        "See the latest tools, frameworks, and technologies in action, while being guided by our amazing speakers.",
      ],
      [
        "Practical knowledge",
        "Walk away with actionable ideas and techniques you can apply at work the very next day. Every talk will add another brick to your knowledge and skill set.",
      ],
      [
        "Future trends",
        "Stay ahead of the curve with talks about emerging technologies and methodologies. Discover what's next, while being anchored in the present.",
      ],
    ],
  },
  {
    eyebrow: "Connect",
    title: "Connect & grow",
    tone: "band" as const,
    items: [
      [
        "Network with peers",
        "Meet hundreds of developers, engineers, and tech enthusiasts from across Europe and beyond. Build connections that last long after the conference.",
      ],
      [
        "Community first",
        "Experience the warmth of a community-organized event. JSHeroes is built by developers, for developers, with genuine passion and care.",
      ],
      [
        "Speaker access",
        "Our format encourages plenty of opportunities to chat with speakers during breaks, meals, and other social events.",
      ],
      [
        "Engage with the local market",
        "Learn about our sponsors during the breaks, find new collaborators, mentors, or potential teammates for your next project.",
      ],
    ],
  },
  {
    eyebrow: "Visit",
    title: "Experience Cluj",
    tone: "paper" as const,
    items: [
      [
        "Amazing venue",
        `Enjoy the conference at ${event.venue.name}, a stunning 5-star venue in the heart of ${event.venue.city}, Romania's tech hub.`,
      ],
      [
        "Social events",
        "Join us for local meetups, community hangouts and other social activities. Make memories while making friends.",
      ],
      [
        "Meet the local community",
        "More than half of our attendees are from Cluj and the surrounding area. Connect with members of our community for an authentic experience.",
      ],
      [
        "Discover Romania",
        "Take the opportunity to discover our beautiful city and the surrounding region of Transylvania. History, nature, and great food await.",
      ],
    ],
  },
];
const tones = ["coral", "blue", "yellow", "mint"] as const;
---

<PageLayout
  title="What's in it for me?"
  eyebrow="Why attend"
  highlight="me"
  intro="JSHeroes is widely regarded as one of the best and most affordable community-organized events in Europe. Past attendees have been returning year after year to reconnect with our local community."
>
  <Section containerClass="pt-6 pb-16 md:pt-10 md:pb-20">
    <div class="prose max-w-[65ch]">
      <p>
        After 10 years of running meetups and conferences, our team has all the
        know-how and resources to put on a great event for professionals and
        enthusiasts alike.
      </p>
      <p>
        If you're not fully convinced yet, below you will find some of the
        reasons why you should attend JSHeroes {event.year}.
      </p>
    </div>
  </Section>

  {groups.map((group, g) => (
    <>
      <Section tone={group.tone} containerClass="py-16 md:py-24">
        <Eyebrow data-reveal="up">{group.eyebrow}</Eyebrow>
        <h2 class="h2-section mt-5 mb-12" data-reveal="up" style="--d:80ms">
          {group.title}
        </h2>
        <div class="grid gap-x-16 gap-y-12 md:grid-cols-2">
          {group.items.map(([title, text], i) => (
            <Feature title={title} tone={tones[(i + g) % 4]}>
              <p class="m-0">{text}</p>
            </Feature>
          ))}
        </div>
      </Section>
      {g === 0 && (
        <PhotoStrip
          names={[
            "event/community5.jpg",
            "event/speak.jpg",
            "event/venue1.jpg",
          ]}
        />
      )}
      {g === 1 && (
        <PhotoStrip
          names={["event/venue4.jpg", "event/city.jpeg", "event/venue3.jpg"]}
        />
      )}
    </>
  ))}

  {cta && (
    <CtaBand
      title="Ready to join us?"
      cta={cta}
      bear="female"
      bubble="Bine ai venit!"
    >
      <p class="m-0">
        JSHeroes {event.year} takes place on {event.dates} in {event.venue.city}
        , Romania. Secure your spot today and be part of something special.
      </p>
    </CtaBand>
  )}
</PageLayout>
