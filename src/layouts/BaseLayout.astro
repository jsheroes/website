---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Preload from "../components/Preload.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { ClientRouter } from "astro:transitions";
import Analytics from "@vercel/analytics/astro";

import { event } from "../data/event";

import "@fontsource-variable/sora";

import "@/assets/base.css";

export interface Props {
  title?: string;
  description?: string;
  /** Path or absolute URL of the social sharing image. */
  image?: string;
}

const {
  title: propsTitle,
  description = `JSHeroes is a yearly event organized by the local JS community in Cluj, Romania. Check the latest updates and join us on ${event.dates}.`,
  image = event.ogImage,
} = Astro.props as Props;

const title = `${event.name} ${event.year} | ${propsTitle ?? event.tagline}`;
const canonical = new URL(Astro.url.pathname, event.siteUrl).href;
const ogImage = new URL(image, event.siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="google-site-verification"
      content="-VWpgQNMZy97BonSpKFQXFiI7wRwtWmdQeKzLjJsH08"
    />
    <link rel="icon" type="image/x-icon" href="/img/social/bear-192.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <Preload />

    <link rel="manifest" href="/manifest.json" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />

    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={event.name} />
    <meta name="twitter:site" content="@jsheroes" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@jsheroes" />

    <ClientRouter />
    <Analytics />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-accent-orange focus:px-4 focus:py-2 focus:text-black-pearl"
    >
      Skip to content
    </a>
    <Navbar />
    <slot />
    <ScrollToTop />
    <Footer />
  </body>
</html>
