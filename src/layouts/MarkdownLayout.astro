---
import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/Section.astro";
import AuthorCard from "../components/AuthorCard.astro";
import { getEntry } from "astro:content";

const { frontmatter } = Astro.props;

const author = frontmatter.author
  ? await getEntry("people", frontmatter.author)
  : undefined;
---

<BaseLayout title={frontmatter.title}>
  <img
    class="block h-[400px] w-full object-cover"
    src={frontmatter.banner || "/img/banners/default.svg"}
    alt=""
  />
  <main id="main">
    <Section variant="light" content="text" class="max-w-none">
      {author && (
        <AuthorCard author={author} publishDate={frontmatter.published} />
      )}
      <div class="prose">
        <h1>{frontmatter.title}</h1>
        <slot />
      </div>
    </Section>
  </main>
</BaseLayout>
