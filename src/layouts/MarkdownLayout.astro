---
import { getEntry } from "astro:content";
import AuthorCard from "../components/AuthorCard.astro";
import Bear from "../components/ui/Bear.astro";
import Section from "../components/ui/Section.astro";
import PageLayout from "./PageLayout.astro";

/** Layout for markdown pages, picked with `layout:` in the frontmatter. */
const { frontmatter } = Astro.props;

const author = frontmatter.author
  ? await getEntry("people", frontmatter.author)
  : undefined;
---

<PageLayout
  title={frontmatter.title}
  eyebrow={frontmatter.eyebrow}
  intro={frontmatter.intro}
  description={frontmatter.description}
  highlight={frontmatter.highlight}
  bears={frontmatter.heroBears}
>
  <Section containerClass="pt-6 pb-20 md:pt-10 md:pb-28">
    {author && (
      <AuthorCard author={author} publishDate={frontmatter.published} />
    )}
    <div class="prose max-w-[65ch]">
      <slot />
    </div>
    {frontmatter.bear && (
      <div class="mt-16">
        <Bear
          who={frontmatter.bear}
          width={frontmatter.bear === "male" ? 200 : 170}
          bubble={frontmatter.bubble}
        />
      </div>
    )}
  </Section>
</PageLayout>
